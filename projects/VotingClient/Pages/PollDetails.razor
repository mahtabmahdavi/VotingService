@page "/poll/{Id:guid}"
@inject VoteService.VoteServiceClient VoteClient

@* @using VotingService.Protos *@
@* @using Grpc.Net.Client *@
@* @using Microsoft.AspNetCore.Components.Forms *@

@* <h3>@poll?.Title</h3> *@
@* <p>@poll?.Description</p> *@

@* @if (poll != null) *@
@* { *@
@*     <EditForm OnValidSubmit="HandleVote"> *@
@*         @foreach (var question in poll.Questions) *@
@*         { *@
@*             <h4>@question.Text</h4> *@
@*             foreach (var option in question.Options) *@
@*             { *@
@*                 <div> *@
@*                     <InputRadio name="@question.Id" @bind-Value="selectedOptionIds[question.Id]" Value="@(option.Id.ToString())" /> *@
@*                     <label>@option.Text (@option.VoteCount votes)</label> *@
@*                 </div> *@
@*             } *@
@*         } *@

@*         <InputText @bind-Value="voterId" placeholder="Your ID" class="form-control" /> *@
@*         <button class="btn btn-primary" type="submit">Vote</button> *@
@*     </EditForm> *@
@*     @if (message != null) *@
@*     { *@
@*         <p>@message</p> *@
@*     } *@
@* } *@
@* else *@
@* { *@
@*     <p>Loading...</p> *@
@* } *@

@* @code { *@
@*     [Parameter] public Guid Id { get; set; } *@
@*     private Poll poll; *@
@*     private string voterId = ""; *@
@*     private string message; *@

@*     private Dictionary<string, string> selectedOptionIds = new(); *@

@*     protected override async Task OnInitializedAsync() *@
@*     { *@
@*         var response = await VoteClient.GetPollByIdAsync(new GetPollByIdRequest { PollId = Id.ToString() }); *@
@*         poll = response.Poll; *@

@*         foreach (var q in poll.Questions) *@
@*         { *@
@*             selectedOptionIds[q.Id] = q.Options.FirstOrDefault()?.Id ?? ""; *@
@*         } *@
@*     } *@

@*     private async Task HandleVote() *@
@*     { *@
@*         foreach (var selected in selectedOptionIds.Values) *@
@*         { *@
@*             var result = await VoteClient.SubmitVoteAsync(new VoteRequest *@
@*             { *@
@*                 OptionId = selected, *@
@*                 VoterId = voterId *@
@*             }); *@

@*             if (!result.Success) *@
@*             { *@
@*                 message = $"Error: {result.Message}"; *@
@*                 return; *@
@*             } *@
@*         } *@

@*         message = "Your vote has been submitted!"; *@
@*     } *@
@* } *@

