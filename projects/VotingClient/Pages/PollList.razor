@page "/poll-list"

@inject VoteService.VoteServiceClient VoteClient
@inject NavigationManager Navigation

<div class="poll-list-container">
    @if (Polls == null)
    {
        <p>Loading polls...</p>
    }
    else
    {
        @foreach (var poll in Polls)
        {
            <div class="poll-list-item-container" @onclick="@(() => NavigateToPoll(poll.Id))" style="cursor:pointer;">
                <h3 class="poll-list-item-h3">@poll.Title</h3>
                <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 320 512" height="20px" width="20px" xmlns="http://www.w3.org/2000/svg">
                    <path d="M310.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-192 192c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L242.7 256
                             73.4 86.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l192 192z"></path>
                </svg>
            </div>
        }
    }
</div>

@code {
    private List<Poll> Polls = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await VoteClient.GetPollsAsync(new Empty());
            Console.WriteLine($"Poll count from server: {response.Polls.Count}");
            Polls = response.Polls.ToList();

        }
        catch (RpcException ex)
        {
            Console.Error.WriteLine($"gRPC error: {ex.Status.Detail}");
            // مدیریت خطا مثل نمایش پیام یا لاگ
        }
    }


    private void NavigateToPoll(string pollId)
    {
        Navigation.NavigateTo($"/poll/{pollId}");
    }
}
